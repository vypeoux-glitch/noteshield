{
  "name": "noteshield",
  "version": "0.1.0",
  "description": "Local sensitive-data audit for Obsidian vaults",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc --noEmit --skipLibCheck && node esbuild.config.mjs production",
    "test": "node --test --experimental-strip-types 'test/*.test.ts'"
  },
  "keywords": [
    "obsidian-plugin",
    "privacy",
    "gdpr",
    "pii",
    "secrets"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.0.0",
    "builtin-modules": "^4.0.0",
    "esbuild": "^0.25.0",
    "obsidian": "latest",
    "typescript": "^5.6.0"
  }
}
